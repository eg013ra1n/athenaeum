#!/usr/bin/env bash
# Mock `curl` for testing the CI helper scripts without hitting real network
# endpoints (Docker Hub, artfrom.space, the GitLab Release API, GitHub, chat
# webhooks). Prepend this file's directory to PATH so it shadows the real curl.
#
# Understands only the flags the helper scripts actually pass:
#   --output FILE --write-out '%{http_code}' --request METHOD --header ...
#   --data @- (body read from stdin) --head --dump-header FILE --max-time N <url>
#
# Behaviour is steered entirely by env vars (all optional, sane defaults):
#   MOCK_CURL_LOGIN_HTTP          HTTP status for the /users/login call (200)
#   MOCK_CURL_JWT                 token value returned by /users/login (fake.jwt.token)
#   MOCK_CURL_GET_HTTP            HTTP status for the repository GET (200)
#   MOCK_CURL_GET_BODY_FILE       path to a file whose contents become the GET
#                                 response body verbatim (default: {"full_description": null})
#   MOCK_CURL_PATCH_HTTP          HTTP status for the repository PATCH (200)
#   MOCK_CURL_CAPTURE_PATCH_BODY  path to write the raw PATCH request body to,
#                                 so a test can inspect what would have been sent
set -euo pipefail

output_file=""
method="GET"
url=""
has_data=0
is_head=0

args=("$@")
i=0
n=${#args[@]}
while [ "$i" -lt "$n" ]; do
  arg="${args[$i]}"
  case "$arg" in
    --output)
      i=$((i + 1))
      output_file="${args[$i]}"
      ;;
    --request)
      i=$((i + 1))
      method="${args[$i]}"
      ;;
    --data)
      has_data=1
      i=$((i + 1))
      ;;
    --head)
      is_head=1
      ;;
    --dump-header)
      i=$((i + 1))
      ;;
    --write-out | --header | --max-time)
      # Options that take one argument we don't otherwise need.
      i=$((i + 1))
      ;;
    --silent | --show-error)
      ;;
    *)
      url="$arg"
      ;;
  esac
  i=$((i + 1))
done

# Only real curl calls that pass --data (e.g. --data @-) read the request
# body from stdin; mirror that exactly so a plain GET (no --data) never
# blocks waiting on stdin that nothing is piping into.
body=""
if [ "$has_data" -eq 1 ]; then
  body="$(cat)"
fi

case "$url" in
  *users/login*)
    http_code="${MOCK_CURL_LOGIN_HTTP:-200}"
    if [ "$http_code" -ge 200 ] && [ "$http_code" -lt 300 ]; then
      printf '{"token": "%s"}' "${MOCK_CURL_JWT:-fake.jwt.token}" > "$output_file"
    else
      printf '{"detail": "mock login failure"}' > "$output_file"
    fi
    ;;
  *artfrom.space/builds/*)
    # verify_release.sh's per-artifact HEAD. MOCK_CURL_ARTIFACT_HTTP (200),
    # MOCK_CURL_ARTIFACT_LENGTH (5000000 bytes), MOCK_CURL_MISSING_ARTIFACTS
    # (space-separated basenames that answer 404 regardless of the above).
    http_code="${MOCK_CURL_ARTIFACT_HTTP:-200}"
    base=$(basename "$url")
    for missing in ${MOCK_CURL_MISSING_ARTIFACTS:-}; do [ "$base" = "$missing" ] && http_code=404; done
    if [ "$is_head" -eq 1 ]; then
      printf 'HTTP/2 %s\ncontent-length: %s\n' "$http_code" "${MOCK_CURL_ARTIFACT_LENGTH:-5000000}" > "$output_file"
    else
      : > "$output_file"
    fi
    ;;
  *hub.docker.com/v2/repositories/*/tags/*)
    # verify_release.sh's Docker Hub tag lookup (version tag + channel tag).
    # Must stay ABOVE the generic *repositories/* arm below, or that arm
    # shadows it. MOCK_CURL_HUB_HTTP (200), MOCK_CURL_HUB_BODY_FILE.
    http_code="${MOCK_CURL_HUB_HTTP:-200}"
    if [ -n "${MOCK_CURL_HUB_BODY_FILE:-}" ] && [ -f "${MOCK_CURL_HUB_BODY_FILE}" ]; then cp "$MOCK_CURL_HUB_BODY_FILE" "$output_file"; else printf '{}' > "$output_file"; fi
    ;;
  *artfrom.space/blog/*)
    # verify_release.sh's blog-post poll. MOCK_CURL_BLOG_HTTP (200).
    http_code="${MOCK_CURL_BLOG_HTTP:-200}"
    printf 'HTTP/2 %s\n' "$http_code" > "$output_file"
    ;;
  */releases)
    # create_gitlab_release.sh's POST. MOCK_CURL_RELEASE_HTTP (201),
    # MOCK_CURL_CAPTURE_RELEASE_BODY captures the raw JSON request body.
    http_code="${MOCK_CURL_RELEASE_HTTP:-201}"
    [ -n "${MOCK_CURL_CAPTURE_RELEASE_BODY:-}" ] && printf '%s' "$body" > "$MOCK_CURL_CAPTURE_RELEASE_BODY"
    printf '{}' > "$output_file"
    ;;
  *repositories/*)
    if [ "$method" = "PATCH" ]; then
      http_code="${MOCK_CURL_PATCH_HTTP:-200}"
      if [ -n "${MOCK_CURL_CAPTURE_PATCH_BODY:-}" ]; then
        printf '%s' "$body" > "${MOCK_CURL_CAPTURE_PATCH_BODY}"
      fi
      printf '{}' > "$output_file"
    else
      http_code="${MOCK_CURL_GET_HTTP:-200}"
      if [ -n "${MOCK_CURL_GET_BODY_FILE:-}" ] && [ -f "${MOCK_CURL_GET_BODY_FILE}" ]; then
        cp "${MOCK_CURL_GET_BODY_FILE}" "$output_file"
      else
        printf '{"full_description": null}' > "$output_file"
      fi
    fi
    ;;
  *api.telegram.org* | *discord.com/api/webhooks*)
    # notify_telegram.sh / notify_discord.sh POSTs. Steered by:
    #   MOCK_CURL_NOTIFY_HTTP   HTTP status to return (default 200)
    #   MOCK_CURL_NOTIFY_BODY   response body verbatim (default {"ok":true})
    http_code="${MOCK_CURL_NOTIFY_HTTP:-200}"
    notify_body="${MOCK_CURL_NOTIFY_BODY:-}"
    [ -n "$notify_body" ] || notify_body='{"ok":true}'
    printf '%s' "$notify_body" > "$output_file"
    ;;
  *api.github.com/repos/*/check-runs*)
    # github_checks_gate.sh. MOCK_CURL_GITHUB_HTTP (200), MOCK_CURL_GITHUB_BODY_FILE,
    # or MOCK_CURL_GITHUB_SEQUENCE_DIR + MOCK_CURL_COUNTER_FILE: call N answers <dir>/N.json,
    # the highest-numbered file repeating once the sequence is exhausted.
    http_code="${MOCK_CURL_GITHUB_HTTP:-200}"
    body_file="${MOCK_CURL_GITHUB_BODY_FILE:-}"
    if [ -n "${MOCK_CURL_GITHUB_SEQUENCE_DIR:-}" ]; then
      counter_file="${MOCK_CURL_COUNTER_FILE:?MOCK_CURL_COUNTER_FILE must be set with a sequence dir}"
      n=$(( $(cat "$counter_file" 2>/dev/null || echo 0) + 1 ))
      printf '%s' "$n" > "$counter_file"
      while [ "$n" -gt 1 ] && [ ! -f "$MOCK_CURL_GITHUB_SEQUENCE_DIR/$n.json" ]; do n=$((n - 1)); done
      body_file="$MOCK_CURL_GITHUB_SEQUENCE_DIR/$n.json"
    fi
    if [ -n "$body_file" ] && [ -f "$body_file" ]; then cp "$body_file" "$output_file"; else printf '{"total_count":0,"check_runs":[]}' > "$output_file"; fi
    ;;
  *)
    echo "mock curl: unrecognised URL: $url" >&2
    http_code="000"
    ;;
esac

printf '%s' "$http_code"
