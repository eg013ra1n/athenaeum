{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athenaeum",
  "version": "0.2.0-4",
  "identifier": "com.vsharifov.athenaeum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Athenaeum",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:event:default",
            "core:event:allow-listen",
            "dialog:allow-open",
            "dialog:allow-save",
            "dialog:allow-confirm",
            "fs:allow-read-dir",
            "fs:allow-read-file",
            "opener:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "scripts/uninstall-macos.sh": "scripts/uninstall-macos.sh",
      "scripts/uninstall-linux.sh": "scripts/uninstall-linux.sh"
    }
  }
}
